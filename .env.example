# ============================================================
# MINISHOP - Cấu hình môi trường (COPY file này thành .env)
#
# Cách dùng:
#   1. cp .env.example .env
#   2. Điền các giá trị bên dưới
#   3. Khởi động lại `npx expo start` để biến môi trường được nạp
#
# LƯU Ý BẢO MẬT:
#   - EXPO_PUBLIC_* là biến "public", nhúng trực tiếp vào bundle JS.
#   - Chỉ điền các giá trị CÔNG KHAI:
#       + Firebase: dùng cấu hình web app (firebase.initializeApp) -> KHÔNG phải service account.
#       + Cloudinary: KHÔNG bao giờ điền API Secret. Chỉ cloud name + unsigned upload preset.
#   - Service account, API secret chỉ nằm ở backend / scripts/seed-firestore.js.
# ============================================================

# ---------------- FIREBASE ----------------
# Vào Firebase Console > Project Settings > Your apps > Web app > Config
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# ---------------- CLOUDINARY ----------------
# Vào Cloudinary Dashboard > Settings > Upload
# EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME  = cloud name của bạn (vd: d3abcxyz)
# EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET = upload preset loại "Unsigned"
#   (Settings > Upload > Add upload preset > Signing Mode = Unsigned)
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# ---------------- MAIL SERVER (Brevo, KHÔNG bắt buộc) ----------------
# URL backend server/ dùng để gửi email xác thực đẹp + tránh spam.
#   - Chạy local: nếu điện thoại thật dùng Expo Go, dùng IP máy trên cùng WiFi
#     (vd http://192.168.1.10:4000); nếu chạy web, dùng http://localhost:4000
#   - Để TRỐNG -> app dùng Firebase gửi email xác thực mặc định.
EXPO_PUBLIC_API_URL=
