# ---------- Firebase Admin (link xác thực) ----------
# Cách 1 (khuyên dùng khi deploy): đặt toàn bộ nội dung JSON của service account
# vào biến FIREBASE_SERVICE_ACCOUNT_JSON (nén 1 dòng).
FIREBASE_SERVICE_ACCOUNT_JSON=

# Cách 2 (chạy local): tải service account về thư mục server/ rồi điền đường dẫn:
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# ---------- Brevo (gửi email) ----------
# API key: Brevo -> Settings -> API Keys
BREVO_API_KEY=your_brevo_api_key

# Email người gửi (phải đã xác thực trong Brevo)
BREVO_SENDER_EMAIL=sender@yourdomain.com
BREVO_SENDER_NAME=MiniShop

# ---------- Server ----------
PORT=4000