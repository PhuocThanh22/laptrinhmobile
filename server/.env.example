# ---------- Firebase Admin (link xác thực) ----------
# Tải service account về thư mục server/ rồi điền đường dẫn tương đối:
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# ---------- Brevo (gửi email) ----------
# API key: Brevo -> Settings -> API Keys
BREVO_API_KEY=your_brevo_api_key

# Email người gửi (phải đã xác thực trong Brevo)
BREVO_SENDER_EMAIL=sender@yourdomain.com
BREVO_SENDER_NAME=MiniShop

# ---------- Server ----------
PORT=4000