{
  "expo": {
    "name": "MiniShop",
    "slug": "minishop",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "minishop",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.minishop.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.minishop.app",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/app-icon.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "MiniShop cần quyền truy cập thư viện ảnh để bạn có thể đăng sản phẩm."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-video",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "MiniShop cần vị trí để hiển thị địa chỉ người bán và chọn vị trí của bạn trên bản đồ."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "742c85af-2406-4cd5-8c2e-600b629dd96b"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/742c85af-2406-4cd5-8c2e-600b629dd96b"
    },
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
